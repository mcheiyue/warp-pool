WARP_INSTANCES=2
INSTANCE_PORT_BASE=40000
# host-reachable direct ports (warppool expose → ns SOCKS via veth)
EXPOSE_PORT_BASE=11000
ENABLE_EXPOSE=1
AGG_SOCKS_PORT=1080
CONTROL_PORT=9090
CONTROL_BIND=127.0.0.1
# Required if CONTROL_BIND is not loopback:
CONTROL_TOKEN=
HEALTH_INTERVAL=60
HEALTH_TIMEOUT=15
ROTATE_COOLDOWN=300
# restart | hard  (soft|reconnect == restart alias)
ROTATE_MODE=restart
REGISTER_STAGGER=5
REGISTER_JITTER_MAX=8
PARTIAL_REGISTER_POLICY=degraded
WARP_CONNECT_TIMEOUT=45
BOOT_HEALTH_WAIT=120
DEREGISTER_ON_SHUTDOWN=0
WARP_LICENSE_KEY=
ENABLE_AGGREGATE=1
ENABLE_CONTROL=1
ENABLE_HEALTH=1
HEALTH_AUTO_ROTATE=0
# scheduled full-pool rotate interval seconds (0=off); runs inside health-loop
ROTATE_SCHEDULE_SEC=0
WEB_ROOT=/opt/warp-pool/web
# SOCKS_BIN=microsocks (preferred, lighter) | gost (fallback if microsocks missing)
# SOCKS_BIN=microsocks
# privileged vs caps: base docker-compose.yml uses privileged: true
# try caps-only: docker compose -f docker-compose.yml -f docker-compose.caps.yml up -d
# (NET_ADMIN+SYS_ADMIN + /dev/net/tun + sysctls); if fails, drop -f ...caps.yml
# SOCKS in netns: microsocks (default) or gost
SOCKS_BIN=microsocks
# v4 pool uniqueness (1=on)
V4_UNIQUE=1
V4_UNIQUE_RETRIES=3
V4_UNIQUE_HARD_RETRIES=2
V4_UNIQUE_BACKOFF=5
# Privileged: docker-compose.yml default. Caps-only try: deploy/compose-caps.yml
