# copy to .env on VPS: cp .env.example .env && edit CONTROL_TOKEN
WARP_POOL_IMAGE=ghcr.io/mcheiyue/warp-pool:latest
WARP_INSTANCES=2
CONTROL_BIND=0.0.0.0
CONTROL_TOKEN=change-me
# 0=默认：业务只连聚合口，不启 11000+ 直连中继
ENABLE_EXPOSE=0
# 1=默认：出池时停 warp-svc 省内存；入池再拉起
PARK_ON_UNPOOL=1
HEALTH_INTERVAL=90
HOST_AGG_PORT=19080
HOST_CONTROL_PORT=19090
# HOST_EXPOSE_BASE=19100
MEM_LIMIT=512m
