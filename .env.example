# copy to .env on VPS: cp .env.example .env && edit CONTROL_TOKEN
WARP_POOL_IMAGE=ghcr.io/mcheiyue/warp-pool:latest
# 与 data 卷内 instances 目录数对齐（boot 以目录为准，此项给期望/文档）
WARP_INSTANCES=5
CONTROL_BIND=0.0.0.0
CONTROL_TOKEN=change-me
# 0=默认：业务只连聚合口，不启 11000+ 直连中继
ENABLE_EXPOSE=0
# 1=默认：出池时停 warp-svc 省内存；入池再拉起
PARK_ON_UNPOOL=1
HEALTH_INTERVAL=90
# 残留锁自动清理秒数（5 分钟默认）
LOCK_STALE_SEC=300
# v0.6：换 IP = chen 式 hard 重抽（清 STATE）
ROTATE_MODE=hard
# 0=probe 失败不自动 hard；死进程由监督/start 拉起
HEALTH_AUTO_ROTATE=0
# 1=对 not_unique 未入座者 hard 推进入座（保护已入座，不互踢）
SEAT_PUSH=1
# 每个 health tick 最多 hard 几个候选（2=扩座更快；稳态全座后几乎无候选）
SEAT_PUSH_PER_PASS=2
REDRAW_MAX=2
# 连败几次后熔断；冷却秒数（须在 compose environment 透传）
ROTATE_FAIL_STREAK_MAX=4
ROTATE_COOLDOWN_SEC=600
COLLISION_ROTATE_THR=3
# 0=全死不 exit 容器（默认）
SUPERVISE_EXIT_ON_ALL_DEAD=0
HOST_AGG_PORT=19080
HOST_CONTROL_PORT=19090
# HOST_EXPOSE_BASE=19100
# N=5 稳态通常 <400MiB；1024m 给 1.9G 主机留余量
MEM_LIMIT=1024m
